# Raw source assets (~64MB of client originals). These are the *input* to the
# CMS, not site content: media reaches the site by being uploaded through
# /keystatic, which writes its own copy under public/. Committing these would
# put them in git history permanently for no benefit.
content/_input/

# Local temp files
temp/
